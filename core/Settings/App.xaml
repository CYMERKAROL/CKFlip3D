<!-- =========================================================================
     Application resources for the Settings app.  The theme dictionary sits at
     the front of the merged list so ThemeService can swap it at runtime.

     Copyright © 2026 Karol Cymerman (CYMERKAROL) — https://github.com/CYMERKAROL/CKFlip3D
     ========================================================================= -->
<Application x:Class="CKFlip3D.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0 = active theme; ThemeService replaces it at runtime. -->
                <ResourceDictionary Source="Theme/Themes/SkeuoDark.xaml"/>
                <ResourceDictionary Source="Theme/Colors.xaml"/>
                <ResourceDictionary Source="Theme/Controls.xaml"/>
                <ResourceDictionary Source="Theme/Navigation.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
