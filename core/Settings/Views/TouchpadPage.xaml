<UserControl x:Class="CKFlip3D.Settings.Views.TouchpadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseWheel="OnPreviewWheel">

    <UserControl.Resources>
        <!-- One bound gesture: its name, a switch that parks it without
             throwing it away, and the X that does throw it away.  Deliberately
             the same row the key lists use — a binding is a binding. -->
        <DataTemplate x:Key="GestureRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="4" Padding="10,5" HorizontalAlignment="Left"
                        Background="{DynamicResource InsetFieldBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <TextBlock FontFamily="Segoe UI" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Label}"/>
                </Border>
                <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                          VerticalAlignment="Center" Margin="12,0,10,0"
                          ToolTip="Off keeps the gesture on the list but stops it acting."
                          IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                <Button Grid.Column="2" Style="{StaticResource LogDismissButton}"
                        VerticalAlignment="Center" ToolTip="Remove this gesture"
                        Tag="{Binding}" Click="RemoveGesture_Click"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource AeroScrollViewer}" VerticalScrollBarVisibility="Auto"
                  Padding="24,4,16,20">
        <StackPanel>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Opening the cascade">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabelText}" Text="Activation gesture"/>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Diagonal swipe gesture used to open the cascade without conflicting with Windows defaults."/>
                    <ItemsControl x:Name="ActivateList" ItemTemplate="{StaticResource GestureRow}"/>
                    <TextBlock x:Name="ActivateEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No gesture opens the cascade. The hotkey and the launch shortcut still do."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActivateStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="ActivateAdd" Style="{StaticResource AccentButton}"
                                Content="Add gesture…" Click="AddActivate_Click"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid x:Name="CancelRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Cancel with the reversed stroke"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Drawing the activation gesture backwards closes the switcher without switching windows."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding TouchpadCancelSwipe}"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Moving through the stack">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingLabelText}" Text="Cycle gesture"/>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Horizontal swipe gesture to switch through windows while the cascade is open"/>
                    <ItemsControl x:Name="CycleList" ItemTemplate="{StaticResource GestureRow}"/>
                    <TextBlock x:Name="CycleEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No swipe steps the stack. The keyboard and the wheel still do."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CycleStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="CycleAdd" Style="{StaticResource AccentButton}"
                                Content="Add gesture…" Click="AddCycle_Click"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Swipe direction"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Sets whether swiping left/right moves with your fingers (Natural), or opposite."/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="DirectionCombo" Style="{StaticResource AeroComboBox}"
                                  VerticalAlignment="Center" MinWidth="230"
                                  SelectionChanged="DirectionCombo_SelectionChanged">
                            <ComboBoxItem Content="Natural"/>
                            <ComboBoxItem Content="Reversed"/>
                        </ComboBox>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Gesture sensitivity"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Adjusts how far your fingers must travel to switch between windows."/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                                       Style="{StaticResource MonoValueText}"
                                       Text="{Binding TouchpadSensitivity, StringFormat={}{0}%}"/>
                            <Slider Style="{StaticResource AeroSlider}" Minimum="1" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding TouchpadSensitivity}" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Gesture smoothing"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Filters out minor touchpad jitter and resting hand noise for cleaner input."/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                                       Style="{StaticResource MonoValueText}"
                                       Text="{Binding TouchpadSmoothing, StringFormat={}{0}%}"/>
                            <Slider Style="{StaticResource AeroSlider}" Minimum="0" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding TouchpadSmoothing}" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <TextBlock Style="{StaticResource SettingLabelText}" Text="Confirm gesture"/>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Gesture used to confirm selection and switch to the highlighted window."/>
                    <ItemsControl x:Name="CommitList" ItemTemplate="{StaticResource GestureRow}"/>
                    <TextBlock x:Name="CommitEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No gesture confirms. The confirm key and the mouse still do."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CommitStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="CommitAdd" Style="{StaticResource AccentButton}"
                                Content="Add gesture…" Click="AddCommit_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Gesture Chaining">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Continuous gestures"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Chain opening and cycling into a single continuous gesture without lifting your fingers"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding TouchpadContinuous}"/>
                    </Grid>
                    <StackPanel x:Name="ContinuousNotice" Orientation="Horizontal"
                                Visibility="Collapsed" Margin="0,12,0,0">
                        <Path Width="13" Height="12" Margin="0,1,7,0" VerticalAlignment="Top"
                              Stroke="#FFE8A33D" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M6.5,1.2 L12.2,11 H0.8 Z M6.5,4.8 V7.6 M6.5,9.2 V9.7"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="11" TextWrapping="Wrap"
                                   MaxWidth="470" Foreground="#FFE8A33D"
                                   Text="May cause misinput (if occuring - Adjust Gesture smoothing and sensitivity)."/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Touchpad activity">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,12"
                               Text="Testing area to preview gesture response live without opening the cascade. Click once and the panel takes over: the pointer is hidden and held inside it, and scrolling stays here. The recogniser uses the settings above, so you can feel them out before applying. Press Esc, or switch away, to get the pointer back."/>

                    <Border x:Name="PadSurface" CornerRadius="6" Height="184" Cursor="Hand"
                            Focusable="True" Background="{DynamicResource InsetFieldBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            ClipToBounds="True" PreviewMouseLeftButtonDown="PadSurface_Click">
                        <Grid>
                            <Canvas x:Name="PadCanvas" ClipToBounds="True"/>
                            <TextBlock x:Name="PadIdleHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       Text="Touch the touchpad…"/>
                            <TextBlock x:Name="ContactCount" Margin="10,8,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Style="{StaticResource MonoValueText}" Opacity="0.65"/>
                            <TextBlock x:Name="ReadingHint" Margin="0,8,10,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       Text="reading — pointer held, press Esc to release"/>
                            <Border x:Name="GestureBadge" Opacity="0" Margin="0,0,0,10"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    CornerRadius="10" Padding="12,5"
                                    Background="{DynamicResource NavActiveBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock x:Name="GestureText" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <!-- Take-over veil: nothing is read from the touchpad,
                                 and the pointer is not held, until it is clicked. -->
                            <Border x:Name="FocusVeil" Background="#A6000000">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Click to read the touchpad"/>
                                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0"
                                               FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               Text="Scrolling and stray gestures are ignored until then."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Defaults">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Resets all touchpad gesture triggers, sensitivity, and smoothing to defaults."/>
                    <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                            Content="Restore default gestures" Click="RestoreDefaults_Click"/>
                </Grid>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
