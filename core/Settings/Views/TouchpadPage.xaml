<UserControl x:Class="CKFlip3D.Settings.Views.TouchpadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseWheel="OnPreviewWheel">

    <ScrollViewer Style="{StaticResource AeroScrollViewer}" VerticalScrollBarVisibility="Auto"
                  Padding="24,4,16,20">
        <StackPanel>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Opening the cascade">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Activation gesture"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="A diagonal stroke opens the cascade. Windows only claims straight slides, so a diagonal is free — your touchpad settings and Task View are untouched. Two or four fingers: Windows already owns three."/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ActivateCombo" Style="{StaticResource AeroComboBox}"
                                  VerticalAlignment="Center" MinWidth="230"
                                  SelectionChanged="ActivateCombo_SelectionChanged">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="Two fingers ↘ (top-left → bottom-right)"/>
                            <ComboBoxItem Content="Two fingers ↙ (top-right → bottom-left)"/>
                            <ComboBoxItem Content="Four fingers ↘ (top-left → bottom-right)"/>
                            <ComboBoxItem Content="Four fingers ↙ (top-right → bottom-left)"/>
                        </ComboBox>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid x:Name="CancelRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Cancel with the reversed stroke"/>
                            <TextBlock x:Name="CancelHint" Style="{StaticResource SettingHintText}"
                                       Text="Drawing the opening diagonal backwards closes the cascade without switching windows — the touchpad's Esc."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding TouchpadCancelSwipe}"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Moving through the stack">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Cycle gesture"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Swipe sideways with this many fingers to walk through the windows while the cascade is open. Only horizontal movement counts, so plain scrolling is unaffected."/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="FingersCombo" Style="{StaticResource AeroComboBox}"
                                  VerticalAlignment="Center" MinWidth="230"
                                  SelectionChanged="FingersCombo_SelectionChanged">
                            <ComboBoxItem Content="Two fingers left / right"/>
                            <ComboBoxItem Content="Four fingers left / right"/>
                        </ComboBox>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Swipe direction"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Natural moves the row with your fingers — swiping left brings the next window in from the right, matching the mouse wheel."/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="DirectionCombo" Style="{StaticResource AeroComboBox}"
                                  VerticalAlignment="Center" MinWidth="230"
                                  SelectionChanged="DirectionCombo_SelectionChanged">
                            <ComboBoxItem Content="Natural"/>
                            <ComboBoxItem Content="Reversed"/>
                        </ComboBox>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Gesture sensitivity"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="How far your fingers travel per window. Higher is quicker — a flick steps several windows; lower asks for a longer, more deliberate drag."/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                                       Style="{StaticResource MonoValueText}"
                                       Text="{Binding TouchpadSensitivity, StringFormat={}{0}%}"/>
                            <Slider Style="{StaticResource AeroSlider}" Minimum="1" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding TouchpadSensitivity}" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Gesture smoothing"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Filters out the small stuff — a resting hand, a twitchy pad, the wobble at the end of a swipe. Higher is steadier but starts moving a fraction later; 0 passes the raw contact motion straight through."/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                                       Style="{StaticResource MonoValueText}"
                                       Text="{Binding TouchpadSmoothing, StringFormat={}{0}%}"/>
                            <Slider Style="{StaticResource AeroSlider}" Minimum="0" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding TouchpadSmoothing}" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Commit gesture"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Switches to the selected window — the touchpad's Enter, so a gesture-opened cascade never needs the keyboard. The downward swipe wants a long, deliberately vertical stroke, and is ignored once the same touch has started cycling."/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="CommitCombo" Style="{StaticResource AeroComboBox}"
                                  VerticalAlignment="Center" MinWidth="230"
                                  SelectionChanged="CommitCombo_SelectionChanged">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="One-finger tap"/>
                            <ComboBoxItem Content="Two-finger tap"/>
                            <ComboBoxItem Content="Two fingers down"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Touchpad activity">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,12"
                               Text="A live view of your touchpad. Click once and the panel takes over: the pointer is hidden and held inside it, and scrolling stays here. Try a gesture — the recogniser uses the settings above, so you can feel them out before applying, and the cascade will not open while you practise. Press Esc, or switch away, to get the pointer back."/>

                    <Border x:Name="PadSurface" CornerRadius="6" Height="184" Cursor="Hand"
                            Focusable="True" Background="{DynamicResource InsetFieldBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            ClipToBounds="True" PreviewMouseLeftButtonDown="PadSurface_Click">
                        <Grid>
                            <Canvas x:Name="PadCanvas" ClipToBounds="True"/>
                            <TextBlock x:Name="PadIdleHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       Text="Touch the touchpad…"/>
                            <TextBlock x:Name="ContactCount" Margin="10,8,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Style="{StaticResource MonoValueText}" Opacity="0.65"/>
                            <TextBlock x:Name="ReadingHint" Margin="0,8,10,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       Text="reading — pointer held, press Esc to release"/>
                            <Border x:Name="GestureBadge" Opacity="0" Margin="0,0,0,10"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    CornerRadius="10" Padding="12,5"
                                    Background="{DynamicResource NavActiveBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock x:Name="GestureText" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <!-- Take-over veil: nothing is read from the touchpad,
                                 and the pointer is not held, until it is clicked. -->
                            <Border x:Name="FocusVeil" Background="#A6000000">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="Click to read the touchpad"/>
                                    <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0"
                                               FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               Text="Scrolling and stray gestures are ignored until then."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Defaults">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Restore the stock gestures: a two-finger ↘ diagonal to open, two fingers left and right to cycle, one-finger tap to commit."/>
                    <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                            Content="Restore default gestures" Click="RestoreDefaults_Click"/>
                </Grid>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
