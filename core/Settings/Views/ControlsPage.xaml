<UserControl x:Class="CKFlip3D.Settings.Views.ControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Style="{StaticResource AeroScrollViewer}" VerticalScrollBarVisibility="Auto"
                  Padding="24,4,16,20">
        <StackPanel>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Input">
                <StackPanel>
                    <!-- Mouse & keyboard sub-menu: the activation hotkey, the
                         commit/cancel keys and the three in-cascade mouse
                         buttons, all in one place so a binding can be chosen
                         while the others are visible. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Mouse &amp; keyboard"/>
                            <TextBlock x:Name="BindingsHint" Style="{StaticResource SettingHintText}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                VerticalAlignment="Center" MinWidth="120"
                                Content="Customize…" Click="ManageBindings_Click"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <!-- Touchpad sub-menu.  Grayed out when the device has no
                         precision touchpad, or while touchpad navigation is
                         switched off in the Navigation card below. -->
                    <Grid x:Name="TouchpadRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Touchpad gestures"/>
                            <TextBlock x:Name="TouchpadHint" Style="{StaticResource SettingHintText}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="TouchpadButton" Style="{StaticResource AeroButton}"
                                VerticalAlignment="Center" MinWidth="120"
                                Content="Customize…" Click="ManageTouchpad_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Activation filters">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Ignore in fullscreen applications"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="When a fullscreen app (game, video, presentation) is in the foreground, the hotkey is passed through to Windows instead of opening the cascade — nothing gets blocked."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding IgnoreFullscreen}"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Ignored applications"/>
                            <TextBlock x:Name="IgnoredSummary" Style="{StaticResource SettingHintText}"
                                       Text="The hotkey is passed through to Windows while any of these programs is in the foreground."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AeroButton}" VerticalAlignment="Center"
                                Content="Manage list…" Click="ManageIgnored_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Navigation">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Mouse wheel cycling"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Scroll the wheel to flip through the cascade."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding MouseWheelCycle}"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Arrow keys navigation"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Arrow keys cycle windows while the cascade is open."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding KeyboardNav}"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid x:Name="TouchpadNavRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Touchpad navigation"/>
                            <TextBlock x:Name="TouchpadNavHint" Style="{StaticResource SettingHintText}"
                                       Text="Swipe two fingers left and right to flip through the cascade, and open it with a two-finger diagonal. Windows' own touchpad gestures are left exactly as they are. Off disables every touchpad gesture — the raw-input listener is not even started."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="TouchpadNavToggle" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding TouchpadNav}"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Defaults">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Restore the default trigger behaviour and clear the ignore list."/>
                    <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                            Content="Restore default bindings" Click="RestoreDefaults_Click"/>
                </Grid>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
