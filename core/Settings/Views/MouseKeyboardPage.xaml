<UserControl x:Class="CKFlip3D.Settings.Views.MouseKeyboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Style="{StaticResource AeroScrollViewer}" VerticalScrollBarVisibility="Auto"
                  Padding="24,4,16,20">
        <StackPanel>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Keys">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Activation hotkey"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="The combination that opens the 3D cascade — keyboard keys, mouse buttons or both. With a held modifier (Ctrl/Shift/Alt/Win), releasing it commits the selection; single-key bindings toggle instead. Click to record a new combination."/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="HotkeyButton" Style="{StaticResource AeroButton}"
                                VerticalAlignment="Center" MinWidth="130"
                                Click="ChangeHotkey_Click">
                            <TextBlock Style="{StaticResource MonoValueText}"
                                       Text="{Binding ActivationHotkey}"/>
                        </Button>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid x:Name="ToggleModeRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Toggle activation"/>
                            <TextBlock x:Name="ToggleModeHint" Style="{StaticResource SettingHintText}"
                                       Text="Keeps the cascade open after the hotkey is released — commit, cancel, and keep cycling with the main key. Off restores the classic hold-to-keep-open behaviour."/>
                        </StackPanel>
                        <!-- Managed from code-behind (no direct binding): a
                             single-key binding is inherently toggle, so the
                             switch shows as ON and grays out without touching
                             the persisted value. -->
                        <CheckBox Grid.Column="1" x:Name="ToggleModeCheck" Style="{StaticResource AeroToggle}"
                                  Checked="ToggleMode_Changed" Unchecked="ToggleMode_Changed"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Commit key"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Switches to the window in front and closes the cascade. Needed for bindings you do not hold down, and always available for the ones you do."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                VerticalAlignment="Center" MinWidth="130"
                                Click="ChangeCommit_Click">
                            <TextBlock Style="{StaticResource MonoValueText}"
                                       Text="{Binding CommitHotkey}"/>
                        </Button>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Cancel key"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Closes the cascade without switching windows. With Search on, the first press clears what you typed and the second one closes."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                VerticalAlignment="Center" MinWidth="130"
                                Click="ChangeCancel_Click">
                            <TextBlock Style="{StaticResource MonoValueText}"
                                       Text="{Binding CancelHotkey}"/>
                        </Button>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid x:Name="CloseKeyRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Close-window key"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Closes the window you are pointing at, or the selected one when the pointer is elsewhere — so it works with the mouse features switched off entirely. The application is asked to close, exactly as if you had clicked its own × — unsaved work still prompts."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                VerticalAlignment="Center" MinWidth="130" Margin="0,0,14,0"
                                IsEnabled="{Binding CloseKeyEnabled}"
                                Click="ChangeCloseKey_Click">
                            <TextBlock Style="{StaticResource MonoValueText}"
                                       Text="{Binding CloseHotkey}"/>
                        </Button>
                        <CheckBox Grid.Column="2" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding CloseKeyEnabled}"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Mouse in the cascade">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Let the mouse act on the stack"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Master switch for everything below — hovering, picking, closing and dragging. Off returns the cascade to the keyboard, the wheel and the touchpad alone: no window reacts to the pointer at all."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding PointerInCascade}"/>
                    </Grid>

                    <StackPanel x:Name="PointerRows" IsEnabled="{Binding PointerInCascade}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Rectangle Style="{StaticResource RowSeparator}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource SettingLabelText}" Text="Pick a window"/>
                                <TextBlock Style="{StaticResource SettingHintText}"
                                           Text="Point at a window in the stack and it lifts slightly; click it to switch. A window further back spins to the front first, then the cascade closes on it."/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                    VerticalAlignment="Center" MinWidth="130" Margin="0,0,14,0"
                                    IsEnabled="{Binding MouseSelect}"
                                    Click="ChangeSelectButton_Click">
                                <TextBlock x:Name="SelectButtonText" Style="{StaticResource MonoValueText}"/>
                            </Button>
                            <CheckBox Grid.Column="2" Style="{StaticResource AeroToggle}"
                                      IsChecked="{Binding MouseSelect}"/>
                        </Grid>
                        <Rectangle Style="{StaticResource RowSeparator}"/>
                        <!-- The close CLICK belongs under the pointer master like
                             every other mouse binding.  The close KEY has its own
                             switch on the Close-window key row above, so nothing
                             here can strand it. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource SettingLabelText}" Text="Close a window"/>
                                <TextBlock Style="{StaticResource SettingHintText}"
                                           Text="Closes the window you are pointing at. The application is asked to close, exactly as if you had clicked its own × — unsaved work still prompts."/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                    VerticalAlignment="Center" MinWidth="130" Margin="0,0,14,0"
                                    IsEnabled="{Binding CloseFromCascade}"
                                    Click="ChangeCloseButton_Click">
                                <TextBlock x:Name="CloseButtonText" Style="{StaticResource MonoValueText}"/>
                            </Button>
                            <CheckBox Grid.Column="2" Style="{StaticResource AeroToggle}"
                                      IsChecked="{Binding CloseFromCascade}"/>
                        </Grid>
                        <Rectangle Style="{StaticResource RowSeparator}"/>
                        <Grid x:Name="DragRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource SettingLabelText}" Text="Drag the stack"/>
                                <TextBlock x:Name="DragHint" Style="{StaticResource SettingHintText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                    VerticalAlignment="Center" MinWidth="130" Margin="0,0,14,0"
                                    IsEnabled="{Binding MouseDragEnabled}"
                                    Click="ChangeDragButton_Click">
                                <TextBlock x:Name="DragButtonText" Style="{StaticResource MonoValueText}"/>
                            </Button>
                            <CheckBox Grid.Column="2" Style="{StaticResource AeroToggle}"
                                      IsChecked="{Binding MouseDragEnabled}"/>
                        </Grid>
                        <StackPanel x:Name="ConflictWarning" Orientation="Horizontal"
                                    Visibility="Collapsed" Margin="0,10,0,0">
                            <Path Width="13" Height="12" Margin="0,1,7,0" VerticalAlignment="Top"
                                  Stroke="#FFE8A33D" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M6.5,1.2 L12.2,11 H0.8 Z M6.5,4.8 V7.6 M6.5,9.2 V9.7"/>
                            <TextBlock x:Name="ConflictText" FontFamily="Segoe UI" FontSize="11"
                                       TextWrapping="Wrap" MaxWidth="470" Foreground="#FFE8A33D"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Defaults">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Restore Win + Tab, Enter to commit, Esc to cancel and Delete to close. The mouse goes back to off, with left to pick, middle to close and right to drag waiting behind it."/>
                    <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                            Content="Restore defaults" Click="RestoreDefaults_Click"/>
                </Grid>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
