<UserControl x:Class="CKFlip3D.Settings.Views.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CKFlip3D.Settings.Views">

    <ScrollViewer Style="{StaticResource AeroScrollViewer}" VerticalScrollBarVisibility="Auto"
                  Padding="24,4,16,20">
        <StackPanel>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Type to filter">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Search the stack"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Start typing while the cascade is open and it narrows to the windows whose names match. The rest drop out of the stack the same way a closed window does, and come straight back when you clear what you typed. Off means printable keys are ignored, exactly as before."/>
                            <!-- Search needs a cascade that stays open without
                                 the hotkey held: you cannot type a word while
                                 holding Win. -->
                            <StackPanel x:Name="ToggleRequirement" Orientation="Horizontal"
                                        Visibility="Collapsed" Margin="0,7,0,0">
                                <Path Width="13" Height="12" Margin="0,1,7,0" VerticalAlignment="Top"
                                      Stroke="#FFE8A33D" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M6.5,1.2 L12.2,11 H0.8 Z M6.5,4.8 V7.6 M6.5,9.2 V9.7"/>
                                <StackPanel>
                                    <TextBlock FontFamily="Segoe UI" FontSize="11" TextWrapping="Wrap"
                                               MaxWidth="430" Foreground="#FFE8A33D"
                                               Text="Searching needs Toggle activation on — otherwise letting go of the hotkey to type closes the cascade, and the rest of the word reaches Windows as shortcuts."/>
                                    <Button Style="{StaticResource AeroButton}" Margin="0,6,0,0"
                                            HorizontalAlignment="Left" Padding="12,3"
                                            Content="Turn on Toggle activation"
                                            Click="EnableToggle_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="SearchToggle" Style="{StaticResource AeroToggle}"
                                  Checked="SearchToggle_Changed" Unchecked="SearchToggle_Changed"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid IsEnabled="{Binding SearchEnabled}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Search box"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="The glass plate behind the field, on the same material as the selected-window label and in the theme chosen under Appearance. Off draws the text straight onto the cascade with a stronger shadow instead."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding SearchBox}"/>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid IsEnabled="{Binding SearchEnabled}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Match program names"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="Searches the owning program's file name as well as the window title, so “chrome” finds a tab whose title mentions neither."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                                  IsChecked="{Binding SearchMatchProcess}"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Placement">
                <StackPanel IsEnabled="{Binding SearchEnabled}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,12"
                               Text="A scale model of your primary display. Drag the field — or click where you want it — and the position is stored as a share of the screen, so it lands in the same place whatever resolution you are running."/>

                    <v:SearchPreview x:Name="Preview"/>

                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Size"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="The text is rendered at the chosen size rather than magnified, so a larger field is genuinely larger type — never a blurred small one."/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                       Style="{StaticResource MonoValueText}"
                                       Text="{Binding SearchScale, StringFormat={}{0}%}"/>
                            <Slider Style="{StaticResource AeroSlider}" Minimum="50" Maximum="200"
                                    IsSnapToTickEnabled="True" TickFrequency="5"
                                    Value="{Binding SearchScale}" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Horizontal position"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="The field's centre, across the screen. 50% is dead centre."/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                       Style="{StaticResource MonoValueText}"
                                       Text="{Binding SearchPosX, StringFormat={}{0}%}"/>
                            <Slider Style="{StaticResource AeroSlider}" Minimum="0" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding SearchPosX}" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource SettingLabelText}" Text="Vertical position"/>
                            <TextBlock Style="{StaticResource SettingHintText}"
                                       Text="The field's bottom edge, down the screen. 94% clears a standard taskbar."/>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                       Style="{StaticResource MonoValueText}"
                                       Text="{Binding SearchPosY, StringFormat={}{0}%}"/>
                            <Slider Style="{StaticResource AeroSlider}" Minimum="0" Maximum="100"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding SearchPosY}" Margin="0,0,10,0"/>
                        </DockPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource RowSeparator}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Put the field back where it started: centred, just above the taskbar, at its natural size."/>
                        <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                                Content="Restore original placement" Click="RestorePlacement_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="How it behaves">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Path Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M8,7 V11.5 M8,4.6 V4.9"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" MaxWidth="530"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Only keys nothing else is bound to reach the search — Tab still cycles, the arrows still navigate, and the commit key still commits. Backspace deletes a character; the cancel key clears the whole query, and closes the cascade once it is empty."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 M8,7 V11.5 M8,4.6 V4.9"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" MaxWidth="530"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Several words all have to match, in any order. A query that matches nothing empties the stack and says so — and while it is empty the cascade will not commit, so a typo cannot switch you to the wrong window. When you do pick one, the rest of the windows slot back in around it before the cascade closes."/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Defaults">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Switch searching back off and restore the stock field."/>
                    <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                            Content="Restore defaults" Click="RestoreDefaults_Click"/>
                </Grid>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
