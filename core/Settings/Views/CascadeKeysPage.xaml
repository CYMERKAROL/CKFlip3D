<!-- =========================================================================
     Cascade keys layout: five binding lists side by side, each one a set of
     keys rather than a single picker.

     Copyright © 2026 Karol Cymerman (CYMERKAROL) — https://github.com/CYMERKAROL/CKFlip3D
     ========================================================================= -->
<UserControl x:Class="CKFlip3D.Settings.Views.CascadeKeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CKFlip3D.Settings.Views">

    <UserControl.Resources>
        <v:StringToVisibilityConverter x:Key="StringVis"/>
        <!-- One binding: the key, the amber mark when it cannot reach the
             cascade as things stand, a switch that parks it without throwing
             it away, and the X that does throw it away. -->
        <DataTemplate x:Key="BindingRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border CornerRadius="4" Padding="10,5"
                            Background="{DynamicResource InsetFieldBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock Style="{StaticResource MonoValueText}" Text="{Binding Token}"/>
                    </Border>
                    <!-- Background is what makes the triangle hoverable: a Path
                         with no Fill only takes hits on its stroke, so the
                         tooltip would be a game of aim. -->
                    <Border Background="Transparent" Padding="8,0,2,0" VerticalAlignment="Center"
                            ToolTip="{Binding Warning}"
                            Visibility="{Binding Warning, Converter={StaticResource StringVis}}">
                        <Path Width="13" Height="12" Stroke="#FFE8A33D" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M6.5,1.2 L12.2,11 H0.8 Z M6.5,4.8 V7.6 M6.5,9.2 V9.7"/>
                    </Border>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource AeroToggle}"
                          VerticalAlignment="Center" Margin="12,0,10,0"
                          ToolTip="Off keeps the key on the list but stops it acting."
                          IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                <Button Grid.Column="2" Style="{StaticResource LogDismissButton}"
                        VerticalAlignment="Center" ToolTip="Remove this key"
                        Tag="{Binding}" Click="RemoveKey_Click"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource AeroScrollViewer}" VerticalScrollBarVisibility="Auto"
                  Padding="24,4,16,20">
        <StackPanel>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Cascade Keybindings">
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Set key bindings for navigating, selecting, and closing windows inside the cascade."/>
                    <!-- Warnings, never refusals: both describe a binding that
                         is perfectly legal and simply will not reach the
                         cascade in the CURRENT configuration, so the answer is
                         to say so, not to take the choice away. -->
                    <StackPanel x:Name="HotkeyClash" Orientation="Horizontal"
                                Visibility="Collapsed" Margin="0,12,0,0">
                        <Path Width="13" Height="12" Margin="0,1,7,0" VerticalAlignment="Top"
                              Stroke="#FFE8A33D" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M6.5,1.2 L12.2,11 H0.8 Z M6.5,4.8 V7.6 M6.5,9.2 V9.7"/>
                        <TextBlock x:Name="HotkeyClashText" FontFamily="Segoe UI" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="450" Foreground="#FFE8A33D"/>
                    </StackPanel>
                    <StackPanel x:Name="SearchClash" Orientation="Horizontal"
                                Visibility="Collapsed" Margin="0,12,0,0">
                        <Path Width="13" Height="12" Margin="0,1,7,0" VerticalAlignment="Top"
                              Stroke="#FFE8A33D" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M6.5,1.2 L12.2,11 H0.8 Z M6.5,4.8 V7.6 M6.5,9.2 V9.7"/>
                        <TextBlock x:Name="SearchClashText" FontFamily="Segoe UI" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="450" Foreground="#FFE8A33D"/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Next window">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Move forward through the stack."/>
                    <ItemsControl x:Name="ForwardList" ItemTemplate="{StaticResource BindingRow}"/>
                    <TextBlock x:Name="ForwardEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No key moves forward. The activation key, the wheel and the touchpad still step the stack."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ForwardStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="ForwardAdd" Style="{StaticResource AccentButton}"
                                Content="Add key…" Click="AddForward_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Previous window">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Move back through the stack."/>
                    <ItemsControl x:Name="BackList" ItemTemplate="{StaticResource BindingRow}"/>
                    <TextBlock x:Name="BackEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No key moves back. Shift with a forward key still reverses it."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BackStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="BackAdd" Style="{StaticResource AccentButton}"
                                Content="Add key…" Click="AddBack_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Confirm">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Switches to the selected window and closes the cascade."/>
                    <ItemsControl x:Name="CommitList" ItemTemplate="{StaticResource BindingRow}"/>
                    <TextBlock x:Name="CommitEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No key confirms. Only the mouse and touchpad can pick a window."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CommitStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="CommitAdd" Style="{StaticResource AccentButton}"
                                Content="Add key…" Click="AddCommit_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Cancel">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Closes the cascade without switching windows, or clears an active search."/>
                    <ItemsControl x:Name="CancelList" ItemTemplate="{StaticResource BindingRow}"/>
                    <TextBlock x:Name="CancelEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No key cancels."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CancelStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="CancelAdd" Style="{StaticResource AccentButton}"
                                Content="Add key…" Click="AddCancel_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Close window">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingHintText}" Margin="0,0,0,8"
                               Text="Closes the window under the pointer, or the selected one."/>
                    <ItemsControl x:Name="CloseList" ItemTemplate="{StaticResource BindingRow}"/>
                    <TextBlock x:Name="CloseEmpty" Style="{StaticResource SettingHintText}"
                               FontStyle="Italic" Visibility="Collapsed"
                               Text="No key closes windows. The close mouse button has its own setting."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CloseStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontFamily="Segoe UI" FontSize="11" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                        <Button Grid.Column="1" x:Name="CloseAdd" Style="{StaticResource AccentButton}"
                                Content="Add key…" Click="AddClose_Click"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Style="{StaticResource SettingsCard}" Header="Defaults">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Resets all bindings back to defaults"/>
                    <Button Grid.Column="1" Style="{StaticResource AeroButton}"
                            Content="Restore to defaults" Click="RestoreDefaults_Click"/>
                </Grid>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
